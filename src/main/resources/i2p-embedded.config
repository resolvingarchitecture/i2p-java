# I2P Service Settings
ra.i2p.isTest=false
ra.i2p.hidden=false
ra.i2p.maxPeers=100


# Router mode: embedded (default) | local | auto
#   embedded - launch an embedded I2P router (needs reseed + a few minutes on first start)
#   local    - attach to an I2P router already running on this host (I2CP 127.0.0.1:7654)
#   auto     - use a local router if detected, else embedded
ra.i2p.mode=embedded
